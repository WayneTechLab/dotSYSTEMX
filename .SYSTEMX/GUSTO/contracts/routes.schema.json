{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WayneTechLab/dotSYSTEMX/blob/main/.SYSTEMX/GUSTO/contracts/routes.schema.json",
  "title": "SYSTEMX optional HR route specification",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^/(admin/hr|employee|manager/hr|contractor)(/[^?#]*)?$"
          },
          "portal": {
            "enum": [
              "admin",
              "employee",
              "manager",
              "contractor"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "capabilityId": {
            "type": "string",
            "minLength": 1
          },
          "backing": {
            "enum": [
              "gusto-sdk",
              "gusto-api",
              "systemx-native",
              "composite"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "enum": [
                "employer-owner",
                "payroll-admin",
                "hr-admin",
                "manager",
                "employee",
                "contractor",
                "auditor"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "mode": {
                  "enum": [
                    "mock",
                    "live-gated"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "label",
                "mode",
                "description"
              ]
            }
          },
          "emptyState": {
            "type": "string",
            "minLength": 1
          },
          "errorState": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "path",
          "portal",
          "title",
          "capabilityId",
          "backing",
          "roles",
          "description",
          "sections",
          "actions",
          "emptyState",
          "errorState"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "routes"
  ]
}
