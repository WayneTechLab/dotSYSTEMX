# Local runtime data and credentials. Project config and project docs are tracked.
# DATA/.gitignore (and each initialized child's DATA/.gitignore) ignores user
# payload recursively while retaining only the exact blank scaffold guides.
/local/
/logs/
/state/
/Projects/*/.SYSTEMXP/local/
/Projects/*/.SYSTEMXP/logs/
/Projects/*/.SYSTEMXP/state/
/.systemx/update.lock
/.systemx/last-check.json
/.systemx/history/
/.systemx/operations/
__pycache__/
*.py[cod]
.DS_Store
.env
.env.*
!.env.example
*.secrets.*
*.pem
*.key
