# Local payload is ignored by Git/GitHub by default. Exact scaffold only.
/*
!/.gitignore
!/README.md
!/TEMP/
/TEMP/*
!/TEMP/README.md
!/LARGE/
/LARGE/*
!/LARGE/README.md
!/IMPORTS/
/IMPORTS/*
!/IMPORTS/README.md
!/RESEARCH/
/RESEARCH/*
!/RESEARCH/README.md
!/ASSETS/
/ASSETS/*
!/ASSETS/README.md
!/EXPORTS/
/EXPORTS/*
!/EXPORTS/README.md
!/CACHE/
/CACHE/*
!/CACHE/README.md
!/ARCHIVE/
/ARCHIVE/*
!/ARCHIVE/README.md
