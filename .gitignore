# Local Python package build and development environments.
/build/
/dist/
/*.egg-info/
/.venv/
__pycache__/
*.py[cod]
.DS_Store

# Maintainer repository boundary only. The portable .SYSTEMX/.gitignore and
# adopted projects' payload, retention, and sharing policies are separate.
# Keep a generic index here; retain static publications/provenance in
# docs/assets and .SYSTEMX/MEDIA instead of film-production subdirectories.
/docs/media/*
!/docs/media/README.md
!/docs/media/build_current_visuals.py
!/docs/media/build_detail_visuals.py
!/docs/media/verify_current_visuals.py

# Explicit repository-root authoring/output locations.
/media-production/
/film-production/
/renders/
/render-output/
/deliverables/
/audio-stems/
/narration-output/

# Playable media, editable film sources, captions, and speech markup are not
# public-template assets. Anchor guards to root files and canonical media
# containers, without ignoring arbitrary adopter source or DATA directories.
